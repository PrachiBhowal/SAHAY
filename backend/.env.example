# Render gives you this when you create a Postgres instance —
# use the "Internal Database URL" if your web service and DB are both on
# Render (faster, no egress cost); use "External Database URL" if you're
# running the backend locally against the cloud DB.
DATABASE_URL=postgresql://user:password@host:5432/dbname

BHASHINI_API_KEY=
BHASHINI_API_URL=
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000
FRONTEND_URL=http://localhost:5173

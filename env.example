# Copy this file to .env and fill in real values locally.
# NEVER commit the actual .env file — only this .env.example template.

# --- Bhashini API (Person 3 owns setup) ---
BHASHINI_API_KEY=
BHASHINI_API_URL=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# --- Backend / Database (Person 5 owns setup) ---
DATABASE_URL=postgres://user:password@localhost:5432/dementia_care_db
JWT_SECRET=
BACKEND_PORT=4000

# --- Frontend (Person 1, Person 6) ---
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001
VITE_API_URL=http://localhost:4000/api

# --- File/media storage (for photos, voice notes, music - decide provider as a team) ---
STORAGE_PROVIDER=
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
